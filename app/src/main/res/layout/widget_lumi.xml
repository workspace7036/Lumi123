<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="12dp">
    <ImageView android:layout_width="56dp" android:layout_height="56dp"
        android:src="@drawable/lumi_f_c" android:layout_marginEnd="12dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#A0A0A8" android:textSize="12sp" android:maxLines="1" />
        <TextView android:id="@+id/w_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="3" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
