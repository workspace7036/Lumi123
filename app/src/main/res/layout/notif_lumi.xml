<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal">
    <ViewFlipper android:id="@+id/flip"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginEnd="12dp" android:layout_marginTop="2dp"
        android:autoStart="true" android:flipInterval="420">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lumi_f_c" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lumi_f_l" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lumi_f_l" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lumi_f_c" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lumi_f_r" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lumi_f_r" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lumi_f_c" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lumi_f_b" />
    </ViewFlipper>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/t" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/x" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
